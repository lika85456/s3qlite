{
	"name": "@lika85456/s3qlite-cli",
	"version": "0.1.1",
	"license": "MIT",
	"bin": {
		"s3qlite": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "rm -rf dist && bun build src/cli.ts --target=node --format=esm --external @tursodatabase/database --outfile=dist/cli.js",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"test": "vitest",
		"test:ci": "vitest run --coverage --silent",
		"test:integration": "vitest",
		"test:fuzzy": "vitest --passWithNoTests",
		"check-types": "tsgo --noEmit"
	},
	"dependencies": {
		"@effect-aws/client-s3": "^1.11.0",
		"@effect/cli": "0.75.0",
		"@effect/platform": "^0.96.0",
		"@effect/platform-node": "^0.106.0",
		"@tursodatabase/database": "^0.6.0",
		"effect": "^3.21.2"
	},
	"devDependencies": {
		"@effect/vitest": "^0.29.0",
		"@lika85456/s3qlite": "workspace:*",
		"@types/node": "^24.0.0",
		"vitest": "^4.1.9"
	}
}