{
	"name": "@lika85456/s3qlite-cli",
	"version": "0.2.0-next.0",
	"license": "MIT",
	"bin": {
		"s3qlite": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "rm -rf dist && bun build src/cli.ts --target=node --format=esm --external @tursodatabase/database --outfile=dist/cli.js",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"test": "vitest",
		"test:ci": "vitest run --coverage --silent",
		"test:integration": "vitest",
		"test:fuzzy": "vitest --passWithNoTests",
		"check-types": "tsgo --noEmit"
	},
	"dependencies": {
		"@effect-aws/client-s3": "^2.0.0",
		"@effect/platform-node": "^4.0.5",
		"@tursodatabase/database": "^0.8.3",
		"effect": "^4.0.5"
	},
	"devDependencies": {
		"@effect/vitest": "^4.0.5",
		"@lika85456/s3qlite": "workspace:*",
		"@types/node": "^24.0.0",
		"vitest": "^5.0.5"
	}
}