{
	"name": "@lika85456/s3qlite",
	"version": "0.4.0-next.0",
	"license": "MIT",
	"repository": "github:lika85456/s3qlite",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/esm/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/dts/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/dts/index.d.ts",
			"import": "./dist/esm/index.js",
			"default": "./dist/esm/index.js"
		},
		"./effect": {
			"types": "./dist/dts/effect.d.ts",
			"import": "./dist/esm/effect.js",
			"default": "./dist/esm/effect.js"
		},
		"./cluster": {
			"types": "./dist/dts/cluster.d.ts",
			"import": "./dist/esm/cluster.js",
			"default": "./dist/esm/cluster.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist",
		"linkDirectory": false
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.esm.json && tsc -p tsconfig.build.dts.json && bun scripts/prepare-dist.ts",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"test": "vitest",
		"test:ci": "vitest run --coverage --silent",
		"test:integration": "vitest --project integration",
		"test:fuzzy": "vitest --project fuzzy",
		"test:cluster": "vitest run --config vitest.cluster.config.ts",
		"check-types": "tsgo --noEmit"
	},
	"dependencies": {
		"protobufjs": "^8.4.2",
		"uuid": "^14.0.0"
	},
	"devDependencies": {
		"@effect-aws/client-s3": "^2.0.0",
		"@effect/platform-bun": "^4.0.5",
		"@effect/platform-node": "4.0.5",
		"@effect/sql-pg": "4.0.5",
		"@effect/vitest": "^4.0.5",
		"@tursodatabase/database": "^0.8.3",
		"bun-types": "^1.3.9",
		"drizzle-orm": "^1.0.0-beta.22",
		"effect": "^4.0.5",
		"fast-check": "^4.8.0"
	},
	"peerDependencies": {
		"@effect-aws/client-s3": "^2.0.0",
		"@effect/platform-node": ">=4.0.1 <5",
		"@tursodatabase/database": "^0.8.3",
		"effect": ">=4.0.1 <5"
	},
	"peerDependenciesMeta": {
		"@effect/platform-node": {
			"optional": true
		}
	}
}